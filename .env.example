# Copy this file to a new file named .env (same folder as app.py) and fill in your values.
# Never commit .env or share it. It is listed in .gitignore.

# Gmail (needs 2-Step Verification and an App password, 16 characters, spaces are ignored)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Optional: if your network blocks SMTP, a Brevo account sends over the web instead
# BREVO_API_KEY=
# BREVO_SENDER=yourname@gmail.com

# Optional: 1 = show the code on screen when the email could not be sent (demo only)
# ALLOW_DEMO_FALLBACK=1
